{
  "name": "dsh-workbench",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DSH 工作台：左栏一个面板，把「AI 改 md → 生成 Word/PDF → 你审这一版」变成一条看得见的时间轴（含版本快照、审批、打开某一版、把漏记的产物收编成记录），另有技能库（读 ctx.skills 的完整技能目录）与文档配对看板（源比产物新就挑到最前）。",
  "license": "MIT",
  "author": "liiydong",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "skills",
    "documentation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liiydong/dsh-workbench.git"
  },
  "homepage": "https://github.com/liiydong/dsh-workbench#readme",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
